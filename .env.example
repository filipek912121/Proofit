# ─────────────────────────────────────────────────────────────
# PROOFIT environment variables
# Copy to .env.local and fill in. Leave Supabase vars empty to run
# in DEMO MODE (in-memory sample data, no real accounts).
# ─────────────────────────────────────────────────────────────

# Public URL of the app (used for auth + Stripe redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Used for XP, completions,
# achievements and subscription writes that users must not control.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (optional — Premium checkout stays disabled until set). Payments also
# require Supabase above: in demo mode nobody can be charged.
# Setup guide (PL): docs/PLATNOSCI.md · automatic setup: node scripts/stripe-setup.mjs
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: ID of a recurring 19.99 PLN / month price. Without it the price is created inline.
STRIPE_PRICE_ID_PREMIUM=
# Local testing only: allow Stripe in demo mode (in-memory data). Never set in production.
STRIPE_ALLOW_DEMO=

# Time zone used to decide what "today" is for check-ins and streaks
APP_TIMEZONE=Europe/Warsaw
